{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker de Cloudflare (plan Free). Sin R2, KV ni Images: nada que pueda facturar.
  "name": "kozaef-training",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kozaef-training"
    }
  ],
  // Dirección provisional *.workers.dev (sin indexar) y vistas previas de las propuestas del bot.
  "workers_dev": true,
  "preview_urls": true,
  // Dominio propio (la zona tiene que estar en Cloudflare; www redirige al dominio sin www).
  "routes": [
    { "pattern": "kozaeftraining.com", "custom_domain": true },
    { "pattern": "www.kozaeftraining.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
