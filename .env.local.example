# =============================================================================
# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore — nunca se sube al repo.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo servidor. NO lleva prefijo NEXT_PUBLIC. Úsala solo en código de servidor
# (Route Handlers / Server Actions / Edge Functions) para tareas admin.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública del sitio (para redirects de OAuth y enlaces de email).
# En local: http://localhost:3000  ·  En prod: https://tu-dominio o la URL de Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# --- Google OAuth ----------------------------------------------------------
# Se configura en el panel de Supabase (Authentication -> Providers -> Google),
# no aquí. Estas dos solo hacen falta si ejecutas Supabase en local con Docker:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cloudflare Turnstile (anti-bots, gratis) --------------------------------
# Sin estas claves, en local los formularios funcionan sin verificación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analítica (gratis). Sin estas claves la analítica queda apagada. ---------
# PostHog (crea el proyecto en la región UE): Project settings -> Project API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Para los gráficos del panel /analitica (solo servidor, NUNCA con NEXT_PUBLIC):
# PostHog -> Settings -> Personal API keys -> crear con permiso "Query: read"
POSTHOG_PERSONAL_API_KEY=
# PostHog -> Settings -> Project -> Project ID (un número)
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Cloudflare Web Analytics: token del "beacon" (o actívalo desde el panel al publicar)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Cal.com (gratis): enlace de tu tipo de evento, p. ej. https://cal.com/kozaef/llamada-20min
# Solo las solicitudes cualificadas lo ven. Sin él, se les dice que les escribirás en 48 h.
CALCOM_URL=

# --- Píxel de Meta (se carga SOLO si el usuario acepta cookies) ---------------
NEXT_PUBLIC_META_PIXEL_ID=

# --- IndexNow (aviso a Bing al publicar). Cualquier cadena de 32+ caracteres ---
INDEXNOW_KEY=

# --- Cabeceras: true = CSP obligatoria (por defecto solo informa) ------------
CSP_ENFORCE=false

# --- Anuncios (solo /aprende y /herramientas). Requiere AdSense + banner TCF -
NEXT_PUBLIC_ADS_ENABLED=false

# --- Plataforma (login/app). false = oculta (lanzamiento actual) -------------
NEXT_PUBLIC_PLATFORM_OPEN=false

# --- Sentry (detección de errores). Crea el proyecto en sentry.io (región EU) --
NEXT_PUBLIC_SENTRY_DSN=
# Opcional, para ver el código original en los errores (source maps):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
