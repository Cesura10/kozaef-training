{
  "name": "entrenamiento-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "node scripts/build-content.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "npm run build && node scripts/patch-middleware-trace.mjs && opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs --drafts",
    "pretypecheck": "node scripts/build-content.mjs --drafts",
    "indexnow": "node --env-file-if-exists=.env.production scripts/indexnow.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "validate:content": "node scripts/build-content.mjs --drafts && vitest run src/content/articles.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "posthog-js": "^1.435.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-config-next": "^16.3.8",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
